# Folders Syncthing keeps identical on every machine. Folder ids must match across machines.
# Labels are the directory names, so a folder accepted from another machine lands at ~/<label>.
# id        path          ignore lists (files in this directory, comma-separated)
git         ~/git         ignore-code,ignore-git
workspace   ~/workspace   ignore-code
documents   ~/Documents
pictures    ~/Pictures
videos      ~/Videos
desktop     ~/Desktop
